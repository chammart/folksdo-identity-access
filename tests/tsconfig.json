{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "..",
    "types": ["node", "jest"]
  },
  "include": [
    "./**/*.ts",
    "../services/*/tests/**/*.ts",
    "../apps/*/tests/**/*.ts"
  ],
  "exclude": ["../node_modules", "../**/dist"]
}
