# -----------------------------------------------------------------------------
# FOLKSDO IAM™ END-TO-END CERTIFICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Copy to .env.e2e. The future E2E runner will load this environment only.
# E2E owns a separate database, ports, broker namespace, and server process.
# -----------------------------------------------------------------------------

NODE_ENV=test
IAM_CERTIFICATION_ENVIRONMENT=e2e

PORT=3210
LOG_LEVEL=silent

FOLKSDO_IAM_E2E_MONGO_PORT=38027
FOLKSDO_IAM_E2E_NATS_PORT=45227
FOLKSDO_IAM_E2E_COMPOSE_PROJECT=folksdo-identity-access-e2e
FOLKSDO_IAM_E2E_KEEP_INFRASTRUCTURE=false

IAM_MONGODB_URI=mongodb://127.0.0.1:38027/?replicaSet=rs0
IAM_MONGODB_DATABASE=folksdo_identity_access_e2e_test

IAM_NATS_URL=nats://127.0.0.1:45227
IAM_NATS_SUBJECT_PREFIX=folksdo.iam.e2e

IAM_SERVICE_NAME=folksdo-identity-access-e2e
IAM_PROCESSING_OUTBOX_BATCH_SIZE=50
IAM_PROCESSING_OUTBOX_POLLING_INTERVAL_MILLISECONDS=25
IAM_PROCESSING_OUTBOX_MAX_ATTEMPTS=3
IAM_PROCESSING_REACTION_MAX_ATTEMPTS=3
IAM_PROCESSING_REACTION_INITIAL_BACKOFF_MILLISECONDS=25
IAM_PROCESSING_REACTION_DEAD_LETTER_SUBJECT=folksdo.iam.e2e.reactions.dead-letter

IAM_BETTER_AUTH_BASE_URL=http://127.0.0.1:3210
IAM_BETTER_AUTH_SECRET=replace-with-at-least-32-characters
IAM_BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3210
IAM_IDENTITY_INVITATION_SESSION_TTL_MILLISECONDS=3600000
IAM_IDENTITY_SIGN_IN_SESSION_TTL_MILLISECONDS=3600000
IAM_IDENTITY_EMAIL_VERIFICATION_TTL_MILLISECONDS=86400000
IAM_IDENTITY_ACCEPTANCE_CAPTURE_ENABLED=true
IAM_IDENTITY_ACCEPTANCE_CAPTURES_COLLECTION_NAME=identity_acceptance_captures

IAM_MEMBERSHIP_INVITATION_TTL_MILLISECONDS=604800000
IAM_MEMBERSHIP_INVITATION_EXPIRATION_INTERVAL_MILLISECONDS=60000
IAM_MEMBERSHIP_INVITATION_EXPIRATION_BATCH_SIZE=100

IAM_E2E_WAIT_TIMEOUT_MILLISECONDS=15000
IAM_E2E_WAIT_INTERVAL_MILLISECONDS=50
