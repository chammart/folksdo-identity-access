# -----------------------------------------------------------------------------
# FOLKSDO IAM™ INTEGRATION CERTIFICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Copy to .env.test. The integration runner loads this environment only.
# -----------------------------------------------------------------------------

NODE_ENV=test
IAM_CERTIFICATION_ENVIRONMENT=integration

PORT=3110
LOG_LEVEL=silent

FOLKSDO_IAM_TEST_MONGO_PORT=37027
FOLKSDO_IAM_TEST_NATS_PORT=44227
FOLKSDO_IAM_TEST_COMPOSE_PROJECT=folksdo-identity-access-test
FOLKSDO_IAM_TEST_KEEP_INFRASTRUCTURE=false

IAM_MONGODB_URI=mongodb://127.0.0.1:37027/?replicaSet=rs0
IAM_MONGODB_DATABASE=folksdo_identity_access_test

IAM_NATS_URL=nats://127.0.0.1:44227
IAM_NATS_SUBJECT_PREFIX=folksdo.iam.test

IAM_SERVICE_NAME=folksdo-identity-access-integration
IAM_PROCESSING_OUTBOX_BATCH_SIZE=50
IAM_PROCESSING_OUTBOX_POLLING_INTERVAL_MILLISECONDS=25
IAM_PROCESSING_OUTBOX_MAX_ATTEMPTS=3
IAM_PROCESSING_REACTION_MAX_ATTEMPTS=3
IAM_PROCESSING_REACTION_INITIAL_BACKOFF_MILLISECONDS=25
IAM_PROCESSING_REACTION_DEAD_LETTER_SUBJECT=folksdo.iam.test.reactions.dead-letter

IAM_BETTER_AUTH_BASE_URL=http://127.0.0.1:3110
IAM_BETTER_AUTH_SECRET=replace-with-at-least-32-characters
IAM_BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3110
IAM_IDENTITY_INVITATION_SESSION_TTL_MILLISECONDS=3600000
IAM_IDENTITY_SIGN_IN_SESSION_TTL_MILLISECONDS=3600000
IAM_IDENTITY_EMAIL_VERIFICATION_TTL_MILLISECONDS=86400000
IAM_IDENTITY_ACCEPTANCE_CAPTURE_ENABLED=true
IAM_IDENTITY_ACCEPTANCE_CAPTURES_COLLECTION_NAME=identity_acceptance_captures

IAM_MEMBERSHIP_INVITATION_TTL_MILLISECONDS=604800000
IAM_MEMBERSHIP_INVITATION_EXPIRATION_INTERVAL_MILLISECONDS=60000
IAM_MEMBERSHIP_INVITATION_EXPIRATION_BATCH_SIZE=100

IAM_TEST_WAIT_TIMEOUT_MILLISECONDS=10000
IAM_TEST_WAIT_INTERVAL_MILLISECONDS=25
