# -----------------------------------------------------------------------------
# FOLKSDO IAM™ LOCAL DEVELOPMENT ENVIRONMENT
# -----------------------------------------------------------------------------
# Copy to .env. Local development must not reuse certification databases.
# -----------------------------------------------------------------------------

NODE_ENV=development

PORT=3100
LOG_LEVEL=info

IAM_MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=rs0&directConnection=true
IAM_MONGODB_DATABASE=folksdo_identity_access_dev

IAM_NATS_URL=nats://127.0.0.1:4227
IAM_NATS_SUBJECT_PREFIX=folksdo.iam

IAM_SERVICE_NAME=folksdo-identity-access
IAM_PROCESSING_OUTBOX_BATCH_SIZE=10
IAM_PROCESSING_OUTBOX_POLLING_INTERVAL_MILLISECONDS=250
IAM_PROCESSING_OUTBOX_MAX_ATTEMPTS=3
IAM_PROCESSING_REACTION_MAX_ATTEMPTS=3
IAM_PROCESSING_REACTION_INITIAL_BACKOFF_MILLISECONDS=250
IAM_PROCESSING_REACTION_DEAD_LETTER_SUBJECT=folksdo.iam.reactions.dead-letter

IAM_BETTER_AUTH_BASE_URL=http://127.0.0.1:3100
IAM_BETTER_AUTH_SECRET=replace-with-at-least-32-characters
IAM_BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3100
IAM_IDENTITY_INVITATION_SESSION_TTL_MILLISECONDS=3600000
IAM_IDENTITY_SIGN_IN_SESSION_TTL_MILLISECONDS=3600000
IAM_IDENTITY_EMAIL_VERIFICATION_TTL_MILLISECONDS=86400000
IAM_IDENTITY_ACCEPTANCE_CAPTURE_ENABLED=false
IAM_IDENTITY_ACCEPTANCE_CAPTURES_COLLECTION_NAME=identity_acceptance_captures

IAM_MEMBERSHIP_INVITATION_TTL_MILLISECONDS=604800000
IAM_MEMBERSHIP_INVITATION_EXPIRATION_INTERVAL_MILLISECONDS=60000
IAM_MEMBERSHIP_INVITATION_EXPIRATION_BATCH_SIZE=100
